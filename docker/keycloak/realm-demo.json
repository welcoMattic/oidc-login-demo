{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "demo",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "fr"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "symfony-demo",
      "name": "Symfony OIDC demo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "symfony-demo-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8001/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "symfony-demo-public",
      "name": "Symfony OIDC demo (public client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8001/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "symfony-demo-es256",
      "name": "Symfony OIDC demo (ES256)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "symfony-demo-es256-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "id.token.signed.response.alg": "ES256",
        "post.logout.redirect.uris": "http://localhost:8001/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "symfony-demo-plain",
      "name": "Symfony OIDC demo (plain PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "symfony-demo-plain-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8001/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
