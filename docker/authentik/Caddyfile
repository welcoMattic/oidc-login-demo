{
	admin off
	auto_https disable_redirects
}

# Serves authentik over HTTPS with the demo certificate, on the same host:port the
# browser and the Symfony backend both use. authentik builds the issuer it announces
# from the forwarded host and scheme, so it advertises https://localhost:9443/... here.
localhost:9443 {
	tls /certs/idp.crt /certs/idp.key
	reverse_proxy authentik:9000
}
