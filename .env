# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
###> oidc demo ###
# The demo Identity Provider runs in Docker and is served over HTTPS, which the
# authenticator requires for the token endpoint. The certificate is generated by
# docker/generate-certs.sh, and trusted through config/packages/http_client.yaml.
#
# Throwaway credentials for a local container, seeded by docker/keycloak/realm-demo.json;
# the provider is served over HTTPS because the authenticator requires it for the
# token endpoint.
OIDC_PROVIDER_URI=https://localhost:8443/realms/demo
OIDC_CLIENT_ID=symfony-demo
OIDC_CLIENT_SECRET=symfony-demo-secret
OIDC_PUBLIC_CLIENT_ID=symfony-demo-public
OIDC_ES256_CLIENT_ID=symfony-demo-es256
OIDC_ES256_CLIENT_SECRET=symfony-demo-es256-secret
OIDC_PLAIN_CLIENT_ID=symfony-demo-plain
OIDC_PLAIN_CLIENT_SECRET=symfony-demo-plain-secret
OIDC_REFRESH_CLIENT_ID=symfony-demo-refresh
OIDC_REFRESH_CLIENT_SECRET=symfony-demo-refresh-secret
# client_secret_jwt keys an HMAC with the secret, which must then be at least 32 bytes for HS256
OIDC_JWT_CLIENT_ID=symfony-demo-jwt
OIDC_JWT_CLIENT_SECRET=symfony-demo-jwt-secret-at-least-32-bytes-long
# private_key_jwt signs with this private JWK; its public half is registered in the realm
OIDC_PKJWT_CLIENT_ID=symfony-demo-pkjwt
OIDC_PKJWT_CLIENT_KEY='{"kid":"symfony-demo-client-2026","use":"sig","alg":"ES256","kty":"EC","crv":"P-256","d":"rp6lrsP8XotFzoQqtWw-V7kiCf2DI5rWK04EvvnlnZ0","x":"gCi_Sux_ZQRyZMZ97vHjv_qxu_2z3qbIqRV9oQ4rlXk","y":"oMXpQOlWKdl8TV-yzXTGSEMLHGBTbA72Sq-KNfeB1-8"}'
###< oidc demo ###
