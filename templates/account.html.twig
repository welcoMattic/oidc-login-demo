{% extends 'base.html.twig' %}

{% block title %}Logged in with {{ scenario.title }}{% endblock %}

{% block body %}
<main>
    <a class="back" href="{{ path('app_home') }}">&larr; back to the scenario list</a>
    <h1>Logged in with {{ scenario.title }}</h1>
    <p class="lead">Firewall <code>{{ firewall }}</code>, Keycloak client <code>{{ scenario.client_id }}</code></p>

    <h2>Who you are now</h2>
    <table>
        <tr><th>User class</th><td><code>{{ userClass ?? 'none' }}</code></td></tr>
        <tr><th>User identifier</th><td><code>{{ user ? user.userIdentifier : '-' }}</code></td></tr>
        <tr><th>Roles</th><td>{% for role in user ? user.roles : [] %}<span class="pill">{{ role }}</span> {% else %}-{% endfor %}</td></tr>
        <tr><th>Access token</th><td>{{ hasAccessToken ? 'received and kept on the security token' : 'none' }}</td></tr>
        <tr><th>Preferred username</th><td><code>{{ user.preferredUsername ?? '-' }}</code></td></tr>
        <tr><th>Email</th><td><code>{{ user.email ?? '-' }}</code></td></tr>
        <tr><th>Sub</th><td><code>{{ user.sub ?? '-' }}</code></td></tr>
    </table>

    <h2>What this firewall demonstrates</h2>
    <ul class="options">
        {% for option in scenario.options %}
            <li><code>{{ option.name }}</code><br><small>{{ option.value }}</small></li>
        {% endfor %}
    </ul>

    <h2>ID token</h2>
    {% if idTokenData %}
        <h3>Header</h3>
        <table>
            <tr><th>alg</th><td><code>{{ idTokenData.header.alg ?? '-' }}</code></td></tr>
            <tr><th>kid</th><td><code>{{ idTokenData.header.kid ?? '-' }}</code></td></tr>
            <tr><th>typ</th><td><code>{{ idTokenData.header.typ ?? '-' }}</code></td></tr>
        </table>

        <h3>Claims</h3>
        <table>
            {% for claim, value in idTokenData.payload %}
                <tr><th>{{ claim }}</th><td><code>{{ value|json_encode|raw }}</code></td></tr>
            {% endfor %}
        </table>
        <p class="lead">Decoded here for display. At login the authenticator checked its
        <code>iss</code>, <code>aud</code>, <code>exp</code>, <code>iat</code>, <code>nonce</code>,
        <code>azp</code>, and that its <code>sub</code> matches the UserInfo one.</p>
    {% else %}
        <p class="lead">No ID token on the security token.</p>
    {% endif %}

    <h2>Logging out</h2>
    <p class="lead">This firewall configures logout to end the Symfony session and, thanks to
    the RP-Initiated Logout listener, to end the Keycloak session too. Clicking the button
    below clears the local session and redirects to Keycloak's end_session_endpoint with
    an <code>id_token_hint</code> and a <code>post_logout_redirect_uri</code>.</p>

    <div class="actions">
        <a class="button" href="{{ path('_logout_' ~ firewall) }}">
            Log out here and at Keycloak
        </a>
        <a class="button button-quiet" href="{{ path('app_home') }}">Try another scenario</a>
    </div>
</main>
{% endblock %}