{% extends 'base.html.twig' %}

{% block title %}Logged in with {{ scenario.title }} - Symfony 8.2 oidc_login{% endblock %}

{% block body %}
<main>
    <a class="back" href="{{ path('app_home') }}">&larr; Back to the scenario list</a>

    <header class="top-bar">
        <div class="title">
            <p class="eyebrow">firewall <code>{{ firewall }}</code></p>
            <h1>{{ scenario.title }}</h1>
            <p class="summary">{{ scenario.summary }}</p>
        </div>
        <div class="session">
            <div class="session-actions">
                {% if user %}
                    <span class="pill">{{ user.preferredUsername ?? user.sub ?? user.userIdentifier }}</span>
                {% endif %}
                <a class="button" href="{{ path('_logout_' ~ firewall) }}">Log out</a>
            </div>
            <span class="small text-muted">also ends the Keycloak session (enable_end_session)</span>
        </div>
    </header>

    <div class="account-layout">
        <aside class="account-sidebar">
            <section class="card">
                <h3>Who you are now</h3>
                <dl class="facts">
                    <dt>User class</dt>
                    <dd><code>{{ userClass ?? 'none' }}</code></dd>
                    <dt>User identifier</dt>
                    <dd><code>{{ user ? user.userIdentifier : '-' }}</code></dd>
                    <dt>Roles</dt>
                    <dd>
                        {% if user %}
                            {% for role in user.roles %}<span class="pill">{{ role }}</span> {% endfor %}
                        {% else %}
                            -
                        {% endif %}
                    </dd>
                    {% if user %}
                        {% for label, value in {'Name': user.name, 'Given name': user.givenName, 'Family name': user.familyName, 'Preferred username': user.preferredUsername, 'Email': user.email, 'Locale': user.locale} %}
                            {% if value is not null %}
                                <dt>{{ label }}</dt>
                                <dd><code>{{ value }}</code></dd>
                            {% endif %}
                        {% endfor %}
                        {% if user.emailVerified is not null %}
                            <dt>Email verified</dt>
                            <dd><code>{{ user.emailVerified ? 'true' : 'false' }}</code></dd>
                        {% endif %}
                    {% endif %}
                </dl>

                {% if user and additionalClaims|length > 0 %}
                    <h4>Additional claims</h4>
                    <pre><code>{{ additionalClaims|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
                {% endif %}

                {% if user and trace is not null and trace.provider is defined %}
                    <p class="card-note">
                        {% if 'KeycloakUserProvider' in trace.provider %}
                            realm_access.roles mapped by App\Security\KeycloakUserProvider
                        {% else %}
                            claims cannot grant roles here
                        {% endif %}
                    </p>
                {% endif %}
            </section>

            <section class="card">
                <h3>What the session holds</h3>
                <dl class="facts">
                    <dt>Access token</dt>
                    <dd>
                        {% if sessionTokens.access_token_expires_at is not null %}
                            {% set left = sessionTokens.access_token_expires_at - sessionTokens.now %}
                            expires at <code>{{ sessionTokens.access_token_expires_at|date('H:i:s T') }}</code>,
                            {% if left > 0 %}in {{ left }} seconds{% else %}expired {{ -left }} seconds ago{% endif %}
                        {% else %}
                            no expiry reported
                        {% endif %}
                    </dd>
                    <dt>Refresh token</dt>
                    <dd>{{ sessionTokens.refresh_token ? 'held (oidc_refresh_token)' : 'none' }}</dd>
                    <dt>Authentication context (acr)</dt>
                    <dd>
                        <code>{{ sessionTokens.acr ?? 'none' }}</code>
                        {% if sessionTokens.acr == '1' %}<span class="small">Keycloak checked your password during this login</span>
                        {% elseif sessionTokens.acr == '0' %}<span class="small">Keycloak answered from its session (single sign-on), no password typed</span>
                        {% endif %}
                    </dd>
                    <dt>Authentication proofs</dt>
                    <dd>
                        {% for method, time in sessionTokens.proofs %}
                            <code>{{ method }}</code> at <code>{{ time|date('H:i:s T') }}</code>, {{ sessionTokens.now - time }} seconds ago<br>
                        {% else %}
                            none
                        {% endfor %}
                    </dd>
                </dl>
                <p class="card-note">
                    The proof time is the <code>auth_time</code> claim of the ID token (<code>*</code> when Keycloak names no <code>amr</code> method): when Keycloak last checked your password, not when this application logged you in. <code>IS_AUTHENTICATED_RECENTLY</code> and <code>IS_AUTHENTICATED_VERY_RECENTLY</code> are decided on it.
                </p>

                {% if firewall == 'refresh' %}
                    <h4>Renewals</h4>
                    {% if renewals is empty %}
                        <p class="small">None yet. Reload this page less than 30 seconds (the leeway) before the access token expires: the firewall renews it with the refresh token before the page is rendered.</p>
                    {% else %}
                        <table class="value-table">
                            <tbody>
                                {% for renewal in renewals|reverse %}
                                    <tr>
                                        <th>{{ renewal.at|date('H:i:s T') }}</th>
                                        <td>
                                            {% if renewal.error %}
                                                <code>{{ renewal.status }} {{ renewal.error }}</code>
                                            {% else %}
                                                <code>refresh_token</code> grant, new access token for {{ renewal.expires_in ?? '?' }} seconds{% if renewal.refresh_token_rotated %}, refresh token rotated{% endif %}{% if renewal.id_token_reissued %}, new ID token{% endif %}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                {% endif %}

                {% if firewall == 'reauth' %}
                    <div class="chips">
                        <a class="button" href="{{ path('app_reauth_sensitive') }}">Open the sensitive page</a>
                    </div>
                    <p class="small">It requires <code>IS_AUTHENTICATED_VERY_RECENTLY</code>: a proof younger than 60 seconds. Past that, you are sent back to Keycloak to type your password again.</p>
                {% endif %}
            </section>

            <section class="card">
                <h3>Firewall configuration</h3>
                {% if scenario.options|length > 0 %}
                    <div class="chips">
                        {% for option in scenario.options %}
                            <span class="option-chip"><strong>{{ option.name }}</strong>: {{ option.value }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if firewallYaml %}
                    <details>
                        <summary>Raw YAML of the firewall</summary>
                        <pre><code>{{ firewallYaml }}</code></pre>
                    </details>
                {% endif %}
            </section>

            {% if profilerToken is not null %}
                <section class="card dev-only">
                    <p class="eyebrow">dev only</p>
                    <h3>Under the hood</h3>
                    <p class="lead small">The profiler panels of the callback request.</p>
                    <div class="chips">
                        <a class="button button-quiet" href="/_profiler/{{ profilerToken }}?panel=security">Security panel</a>
                        <a class="button button-quiet" href="/_profiler/{{ profilerToken }}?panel=http_client">HTTP Client panel</a>
                    </div>
                </section>
            {% endif %}
        </aside>

        <div class="account-main">
            <h2>What just happened</h2>

            {% if trace is null %}
                <section class="card">
                    <p class="lead">No login flow trace available. The session might have been opened another way.</p>
                </section>
            {% else %}
                <ol class="trace-steps">
                    {# Step 1: the authorization request #}
                    <li class="trace-step">
                        <h4>
                            {% if trace.trigger == 're_authentication' %}A sensitive page asked you to authenticate again
                            {% elseif trace.trigger == 'start_route' %}You clicked Log in
                            {% else %}You asked for a protected page
                            {% endif %}
                        </h4>
                        {% if trace.trigger == 're_authentication' %}
                            <p class="meaning"><code>{{ trace.re_authentication_attribute ?? 'IS_AUTHENTICATED_VERY_RECENTLY' }}</code> was denied to an authenticated user: instead of a 403, the firewall asked its re-authentication entry point, the oidc_login authenticator, for a new authorization request, and saved the page to come back to.</p>
                        {% endif %}
                        <dl class="kv">
                            <dt>Requested path</dt>
                            <dd>{{ trace.requested_path }}</dd>
                            <dt>Authorization endpoint</dt>
                            <dd>{{ trace.auth_request.endpoint }}</dd>
                        </dl>
                        <table class="param-table">
                            <thead>
                                <tr><th>Parameter</th><th>Value</th><th>Meaning</th></tr>
                            </thead>
                            <tbody>
                                {% for param, value in trace.auth_request.params %}
                                    <tr>
                                        <td><code>{{ param }}</code></td>
                                        <td><code>{{ value }}</code></td>
                                        <td class="meaning-cell">
                                            {% if param == 'response_type' %}the Authorization Code Flow
                                            {% elseif param == 'client_id' %}the OIDC client identifier
                                            {% elseif param == 'redirect_uri' %}must be registered at the provider
                                            {% elseif param == 'scope' %}openid is always added
                                            {% elseif param == 'state' %}stops login CSRF, checked on the callback
                                            {% elseif param == 'nonce' %}binds the ID token to this request
                                            {% elseif param == 'code_challenge' %}PKCE, the SHA-256 of a verifier kept in the session
                                            {% elseif param == 'code_challenge_method' %}PKCE
                                            {% elseif param == 'max_age' %}how old the authentication at Keycloak may be
                                            {% elseif param == 'prompt' and trace.trigger == 're_authentication' %}forced by the re-authentication: Keycloak asks for the password even with a live session
                                            {% elseif param == 'id_token_hint' %}your current ID token: tells Keycloak which user must authenticate again
                                            {% elseif param in ['login_hint', 'ui_locales'] and firewall == 'hint' %}set per request by a listener of OidcAuthorizationRequestEvent
                                            {% elseif param in ['prompt', 'login_hint', 'ui_locales'] %}from authorization_params
                                            {% else %}{{ param }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </li>

                    {# Step 2: the callback #}
                    <li class="trace-step">
                        <h4>Keycloak authenticated you and sent you back</h4>
                        <dl class="kv">
                            <dt>Callback path</dt>
                            <dd>{{ trace.callback.path }}</dd>
                            {% for key, value in trace.callback.query %}
                                {% if value is not null %}
                                    <dt>{{ key }}</dt>
                                    <dd>{{ value }}</dd>
                                {% endif %}
                            {% endfor %}
                        </dl>
                        <table class="check-table">
                            <thead>
                                <tr><th>Check</th><th>Result</th></tr>
                            </thead>
                            <tbody>
                                {% for check in trace.checks %}
                                    {% if check.label == 'state' %}
                                        <tr>
                                            <td><code>state</code></td>
                                            <td class="ok">{{ check.detail }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </li>

                    {# Step 3: the code exchange #}
                    {% if trace.exchanges.token|length > 0 %}
                        <li class="trace-step">
                            <h4>The code was exchanged for tokens</h4>
                            {% for exchange in trace.exchanges.token %}
                                <dl class="kv">
                                    <dt>Request</dt>
                                    <dd><code>{{ exchange.method }}</code> {{ exchange.url }}</dd>
                                    {% if exchange.request_auth is defined %}
                                        <dt>Client authentication</dt>
                                        <dd>{{ exchange.request_auth }}</dd>
                                    {% endif %}
                                    {% if exchange.request_body is defined and exchange.request_body is not empty %}
                                        {% for key, value in exchange.request_body %}
                                            <dt>{{ key }}</dt>
                                            <dd>{{ value }}</dd>
                                        {% endfor %}
                                    {% endif %}
                                </dl>
                                {% if exchange.client_assertion is defined %}
                                    <p class="table-title">The client assertion, decoded (its signature is what authenticates the client)</p>
                                    <table class="value-table">
                                        <tbody>
                                            {% for key, value in exchange.client_assertion.header %}
                                                <tr><th>header.{{ key }}</th><td><code>{{ value|json_encode }}</code></td></tr>
                                            {% endfor %}
                                            {% for key, value in exchange.client_assertion.payload %}
                                                <tr>
                                                    <th>{{ key }}</th>
                                                    <td>
                                                        <code>{{ value|json_encode(constant('JSON_UNESCAPED_SLASHES')) }}</code>
                                                        {% if key == 'aud' %}<span class="text-muted">the token endpoint</span>
                                                        {% elseif key == 'jti' %}<span class="text-muted">unique, so that the provider can refuse a replay</span>
                                                        {% elseif key == 'exp' %}<span class="text-muted">{{ value - exchange.client_assertion.payload.iat|default(value) }} seconds after iat (lifetime)</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endif %}
                                {% if exchange.response_summary is not empty %}
                                    <p class="table-title">Token response</p>
                                    <table class="value-table">
                                        <tbody>
                                            {% for key, value in exchange.response_summary %}
                                                <tr>
                                                    <th>{{ key }}</th>
                                                    <td><code>{{ value|json_encode }}</code></td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endif %}
                            {% endfor %}
                        </li>
                    {% endif %}

                    {# Step 4: the ID token #}
                    {% if trace.id_token_decoded is not null %}
                        <li class="trace-step">
                            <h4>The ID token was verified</h4>
                            <dl class="kv">
                                {% for key, value in trace.id_token_decoded.header %}
                                    <dt>{{ key }}</dt>
                                    <dd>{{ value|json_encode }}</dd>
                                {% endfor %}
                                {% if trace.signature_key is not null %}
                                    <dt>Signature key</dt>
                                    <dd>kid {{ trace.signature_key.kid }}, {{ trace.signature_key.kty }}{% if trace.signature_key.crv is defined %} {{ trace.signature_key.crv }}{% endif %}{% if trace.signature_key.alg is defined %}, {{ trace.signature_key.alg }}{% endif %}{% if trace.signature_key.use is defined %}, use {{ trace.signature_key.use }}{% endif %}</dd>
                                    <dt>Key source</dt>
                                    <dd>{{ trace.signature_key.source }}</dd>
                                {% endif %}
                            </dl>
                            <table class="check-table">
                                <thead>
                                    <tr><th>Check</th><th>Result</th></tr>
                                </thead>
                                <tbody>
                                    {% for check in trace.checks %}
                                        {% if check.label in ['signature', 'iss', 'aud', 'azp', 'exp', 'iat', 'nbf', 'nonce', 'auth_time'] %}
                                            <tr>
                                                <td><code>{{ check.label }}</code></td>
                                                <td class="ok">{{ check.detail }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </li>
                    {% endif %}

                    {# Step 5: the claims #}
                    {% if 'id_token' == trace.user_data_source %}
                        <li class="trace-step">
                            <h4>Your claims were read from the ID token</h4>
                            <p class="meaning">user_data_source is id_token: no request to UserInfo was made, the claims are those of the validated ID token.</p>
                            {% if trace.user_badge is not empty %}
                                <p class="table-title">Claims</p>
                                <table class="value-table">
                                    <tbody>
                                        {% for key, value in trace.user_badge %}
                                            <tr>
                                                <th>{{ key }}</th>
                                                <td><code>{{ value|json_encode }}</code></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                            <table class="check-table">
                                <thead>
                                    <tr><th>Check</th><th>Result</th></tr>
                                </thead>
                                <tbody>
                                    {% for check in trace.checks %}
                                        {% if check.label == 'sub' %}
                                            <tr>
                                                <td><code>{{ check.label }}</code></td>
                                                <td class="ok">{{ check.detail }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </li>
                    {% elseif trace.exchanges.userinfo|length > 0 %}
                        <li class="trace-step">
                            <h4>Your claims were fetched from UserInfo</h4>
                            {% for exchange in trace.exchanges.userinfo %}
                                <dl class="kv">
                                    <dt>Request</dt>
                                    <dd><code>{{ exchange.method }}</code> {{ exchange.url }}</dd>
                                    {% if exchange.request_auth is defined %}
                                        <dt>Authentication</dt>
                                        <dd>{{ exchange.request_auth }}</dd>
                                    {% endif %}
                                </dl>
                                {% if exchange.response_summary is not empty %}
                                    <p class="table-title">Claims</p>
                                    <table class="value-table">
                                        <tbody>
                                            {% for key, value in exchange.response_summary %}
                                                <tr>
                                                    <th>{{ key }}</th>
                                                    <td><code>{{ value|json_encode }}</code></td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endif %}
                            {% endfor %}
                            <table class="check-table">
                                <thead>
                                    <tr><th>Check</th><th>Result</th></tr>
                                </thead>
                                <tbody>
                                    {% for check in trace.checks %}
                                        {% if check.label == 'sub' %}
                                            <tr>
                                                <td><code>{{ check.label }}</code></td>
                                                <td class="ok">{{ check.detail }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </li>
                    {% endif %}

                    {# Step 6: the user #}
                    <li class="trace-step">
                        <h4>The user was built</h4>
                        <dl class="kv">
                            <dt>Provider</dt>
                            <dd>{{ trace.provider }}</dd>
                            <dt>User class</dt>
                            <dd>{{ trace.user.class }}</dd>
                            <dt>Identifier</dt>
                            <dd>{{ trace.user.identifier }} <span class="text-muted">{% if trace.user_identifier_claim == 'sub' %}(the sub claim, the default){% else %}(the {{ trace.user_identifier_claim }} claim, as user_identifier_claim says){% endif %}</span></dd>
                            <dt>Roles</dt>
                            <dd>{% for role in trace.user.roles %}<span class="pill">{{ role }}</span> {% endfor %}</dd>
                        </dl>
                        <p class="meaning">
                            {% if 'KeycloakUserProvider' in trace.provider %}
                                realm_access.roles mapped by App\Security\KeycloakUserProvider
                            {% else %}
                                claims cannot grant roles here
                            {% endif %}
                        </p>
                    </li>

                    {# Step 7: the session #}
                    <li class="trace-step">
                        <h4>A session was opened</h4>
                        <dl class="kv">
                            <dt>Token attributes</dt>
                            <dd>{% for attr in trace.authenticated_token.attributes %}<code>{{ attr }}</code> {% endfor %}</dd>
                            <dt>Flow duration</dt>
                            <dd>{{ trace.duration_ms }} ms</dd>
                        </dl>
                        <p class="meaning">
                            Log out runs OidcEndSessionListener (enable_end_session: true): a redirect to the end_session_endpoint with id_token_hint and post_logout_redirect_uri, then Keycloak sends you back to /.
                        </p>
                    </li>
                </ol>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
