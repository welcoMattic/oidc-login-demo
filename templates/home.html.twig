{% extends 'base.html.twig' %}

{% block title %}Symfony 8.2 oidc_login - OpenID Connect Demo{% endblock %}

{% block body %}
<main>
    <div class="hero">
        <p class="eyebrow">OpenID Connect Authorization Code Flow, natively</p>
        <h1>Symfony 8.2 <code>oidc_login</code></h1>
        <p class="lead">An anonymous request to a protected page is redirected to Keycloak; the authenticator exchanges the code, verifies the ID token, reads the claims and opens a session.</p>
    </div>

    {% if error is not null %}
        <div class="error-banner">
            <strong>Authentication Error:</strong> {{ error.message }}
        </div>
    {% endif %}

    {% for group, groupScenarios in {
        'Client types': ['default', 'public'],
        'Client authentication at the token endpoint': ['basic', 'secretjwt', 'privatekeyjwt'],
        'The authorization request': ['strict', 'plain', 'hint'],
        'The ID token': ['es256'],
        'The user and the claims': ['roles', 'email', 'idtoken'],
        'The session': ['refresh', 'reauth'],
        'The routes': ['callback']
    } %}
        <div class="section">
            <h2>{{ group }}</h2>
            <div class="cards">
                {% for scenarioName in groupScenarios %}
                    {% set scenario = scenarios[scenarioName] %}
                    <div class="card scenario">
                        <h3>{{ scenario.title }}</h3>
                        <p class="summary">{{ scenario.summary }}</p>
                        <div class="meta">
                            <code>{{ scenarioName }}</code>
                        </div>
                        <div class="actions">
                            <a class="button" href="{{ path('_oidc_login_start_' ~ scenarioName) }}">
                                Log in
                            </a>
                            {% if scenarioName == 'hint' %}
                                <a class="button button-quiet" href="{{ path('_oidc_login_start_hint', {login_hint: 'bob'}) }}">
                                    Log in as bob
                                </a>
                            {% elseif scenarioName == 'reauth' %}
                                <a class="button button-quiet" href="{{ path('app_reauth_sensitive') }}">
                                    Open the sensitive page
                                </a>
                            {% else %}
                                <a class="button button-quiet" href="{{ path('app_account', {firewall: scenarioName}) }}">
                                    Open a protected page
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    <div class="footer">
        <p>
            <strong>Credentials:</strong> alice / alice has the admin and editor roles, bob / bob only editor.
            <a href="https://localhost:8443/admin/">Keycloak admin console</a> (admin / admin).
        </p>
    </div>
</main>
{% endblock %}
