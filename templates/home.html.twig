{% extends 'base.html.twig' %}

{% block body %}
<main>
    <h1>Symfony OIDC login demo</h1>
    <p class="lead">Symfony's <code>oidc_login</code> authenticator (OpenID Connect Authorization
    Code Flow) against real Identity Providers running in Docker. One firewall per provider,
    each one configured differently, so a single login shows the option set at work.</p>

    {% for key, provider in providers %}
        <a class="card" href="{{ path('app_' ~ key) }}">
            <strong>Log in with {{ provider.label }}</strong><br>
            <small>{{ provider.credentials }} &middot; firewall <code>{{ key }}</code></small>
        </a>
    {% endfor %}

    <h2>What happens when you click</h2>
    <p class="lead">The page behind the link requires <code>ROLE_USER</code>. The firewall's entry
    point sends you to the provider with a <code>state</code>, a <code>nonce</code> and a PKCE
    challenge, the provider sends you back to <code>/&lt;provider&gt;/callback</code>, and the
    authenticator exchanges the code for tokens before building the user from the claims. The next
    page shows what came out of it.</p>
</main>
{% endblock %}
