{% extends 'base.html.twig' %}

{% block title %}Logged in with {{ provider.label }}{% endblock %}

{% block body %}
<main>
    <a class="back" href="{{ path('app_home') }}">&larr; back to the provider list</a>
    <h1>Logged in with {{ provider.label }}</h1>
    <p class="lead">Firewall <code>{{ firewall }}</code>, issuer <code>{{ provider.issuer }}</code></p>

    <h2>Who you are now</h2>
    <table>
        <tr><th>User class</th><td><code>{{ userClass ?? 'none' }}</code></td></tr>
        <tr><th>User identifier</th><td><code>{{ user ? user.userIdentifier : '-' }}</code></td></tr>
        <tr><th>Roles</th><td>{% for role in user ? user.roles : [] %}<span class="pill">{{ role }}</span> {% else %}-{% endfor %}</td></tr>
        <tr><th>Access token</th><td>{{ hasAccessToken ? 'received and kept on the security token' : 'none' }}</td></tr>
    </table>
    <p class="lead">Roles are <code>ROLE_USER</code> on purpose: the built-in <code>oidc</code> user
    provider never lets a claim grant a role. See the README to map claims onto roles with your own
    user provider.</p>

    <h2>What this firewall demonstrates</h2>
    <ul class="options">
        {% for option, effect in provider.options %}
            <li><code>{{ option }}</code><br><small>{{ effect }}</small></li>
        {% endfor %}
    </ul>

    <h2>Standard claims on the user</h2>
    {% if standardClaims is empty %}
        <p class="lead">None: the provider returned nothing beyond the identifier.</p>
    {% else %}
        <table>
            {% for claim, value in standardClaims %}
                <tr><th>{{ claim }}</th><td><code>{{ value }}</code></td></tr>
            {% endfor %}
        </table>
    {% endif %}

    <h2>Additional claims</h2>
    {% if additionalClaims %}
        <pre>{{ additionalClaims }}</pre>
        <p class="lead">Every claim that matches no standard one is kept here, untouched.</p>
    {% else %}
        <p class="lead">None: every claim the provider returned maps onto a standard one.</p>
    {% endif %}

    <h2>ID token claims</h2>
    {% if idTokenClaims %}
        <pre>{{ idTokenClaims }}</pre>
        <p class="lead">Decoded here for display. At login the authenticator checked its
        <code>iss</code>, <code>aud</code>, <code>exp</code>, <code>iat</code>, <code>nonce</code>
        and <code>azp</code>, and that its <code>sub</code> matches the UserInfo one.</p>
    {% else %}
        <p class="lead">No ID token on the security token.</p>
    {% endif %}

    <h2>Logging out</h2>
    {% if provider.end_session ?? false %}
        <p class="lead">This firewall sets <code>enable_end_session: true</code>, so the button below
        does an <strong>RP-Initiated Logout</strong>: Symfony clears the session, then sends you to the
        provider's <code>end_session_endpoint</code> with an <code>id_token_hint</code> and a
        <code>post_logout_redirect_uri</code>, so the session at
        {{ provider.label }} ends too. Where you land last is the provider's call.</p>
    {% else %}
        <p class="lead">This firewall leaves <code>enable_end_session</code> off, so the button below
        only clears the Symfony session. You would still be signed in at {{ provider.label }}, and
        logging in again would not ask for a password.</p>
    {% endif %}

    <div class="actions">
        {# data-turbo="false" is not cosmetic: the logout response is a 302 to the provider's
           end_session_endpoint, on another origin, and Turbo Drive turns the navigation into a
           fetch it cannot follow. The request never leaves the browser, the session at the
           provider survives, and the only visible symptom is landing back on the home page. #}
        <a class="button" data-turbo="false" href="{{ path('_logout_' ~ firewall) }}">
            {{ (provider.end_session ?? false) ? 'Log out here and at ' ~ provider.label : 'Log out locally' }}
        </a>
        <a class="button button-quiet" href="{{ path('app_home') }}">Try another provider</a>
    </div>
</main>
{% endblock %}
